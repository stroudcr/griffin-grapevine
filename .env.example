# Beehiiv Newsletter API
# Required for newsletter subscription functionality
BEEHIIV_API_KEY=your_beehiiv_api_key_here
BEEHIIV_PUBLICATION_ID=your_beehiiv_publication_id_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.griffingrapevine.com

# Analytics (optional)
# Meta/Facebook Pixel ID for tracking
NEXT_PUBLIC_META_PIXEL_ID=

# Local Business Guide (/directory). Without these the guide still shows its
# free listings; paid signup, owner sign-in and the admin page switch on once set.
DATABASE_URL=                     # Neon Postgres; tables create themselves
STRIPE_SECRET_KEY=                # Stripe key; the guide creates its own product and prices (gg_guide_featured_*)
STRIPE_WEBHOOK_SECRET=            # signing secret for https://www.griffingrapevine.com/api/stripe/webhook
STRIPE_PORTAL_CONFIGURATION_ID=   # optional; Stripe's default customer portal is used otherwise
DIRECTORY_SESSION_SECRET=         # long random string that signs sign-in cookies
DIRECTORY_ADMIN_EMAILS=           # comma-separated; these emails can approve listings
EMAIL_FROM=guide@griffingrapevine.com
CLOUDFLARE_ACCOUNT_ID=            # Cloudflare Email Service, for sign-in and receipt emails
CLOUDFLARE_EMAIL_API_TOKEN=
BLOB_READ_WRITE_TOKEN=            # Vercel Blob, for listing photos
